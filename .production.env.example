# ==============================================================================
# ŞEHİTKAMİL+ / GÖLBOX PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL PASSWORDS, TOKENS, OR API KEYS TO REPOSITORY.
# Copy this template to .env.production on host server or configure variables
# directly in systemd, Docker secrets, Kubernetes secrets, or server env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API (ASP.NET Core)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Database (SQL Server required - SQLite rejected in Production)
ConnectionStrings__Default=Server=sql.example.gov.tr,1433;Database=SehitkamilDb;User Id=sehitkamil_app;Password=REPLACE_WITH_SECURE_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=True;

# JWT Authentication (Min 32 characters, non-default secret)
Jwt__Key=REPLACE_WITH_SECURE_RANDOM_JWT_KEY_MIN_32_CHARS_LONG
Jwt__Issuer=GolBox.Api
Jwt__Audience=GolBox.Frontend

# Dynamic QR Security (Min 32 characters, non-default secret)
Security__DynamicQr__HmacKey=REPLACE_WITH_SECURE_RANDOM_HMAC_KEY_MIN_32_CHARS_LONG
Security__DynamicQr__AllowLegacyGuid=false

# CORS Allowed Origins (Explicit origins, NO wildcard '*')
Security__Cors__AllowedOrigins__0=https://sehitkamil.gov.tr
Security__Cors__AllowedOrigins__1=https://admin.sehitkamil.gov.tr

# Storage Options (Persistent volume path)
Storage__UploadsPath=/var/lib/sehitkamil/uploads
Storage__PublicBaseUrl=https://api.sehitkamil.gov.tr

# Bootstrap Admin (First-boot only, remove after setting password)
BootstrapAdmin__Email=admin@sehitkamil.gov.tr
BootstrapAdmin__Password=REPLACE_WITH_SECURE_INITIAL_ADMIN_PASSWORD_MIN_12_CHARS

# ------------------------------------------------------------------------------
# 2. CITIZEN FRONTEND (Next.js - Build Time Envs)
# ------------------------------------------------------------------------------
# API Base URL (Omit if using same-origin reverse proxy)
NEXT_PUBLIC_API_BASE_URL=https://api.sehitkamil.gov.tr/api/v1

# SignalR WebSocket Hub Base URLs (Omit if using same-origin reverse proxy)
NEXT_PUBLIC_HUB_URL=https://api.sehitkamil.gov.tr/hubs/orders
NEXT_PUBLIC_NOTIFICATION_HUB_URL=https://api.sehitkamil.gov.tr/hubs/notifications

# Tile Map Provider (Public OpenStreetMap tile URL is rejected in Production build)
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.sehitkamil.gov.tr/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Şehitkamil Belediyesi Harita Servisi

# ------------------------------------------------------------------------------
# 3. ADMIN FRONTEND (Vite - Build Time Envs)
# ------------------------------------------------------------------------------
# API Base URL (Omit if using same-origin reverse proxy)
VITE_API_BASE_URL=https://api.sehitkamil.gov.tr/api/v1

# Tile Map Provider (Public OpenStreetMap tile URL is rejected in Production build)
VITE_MAP_TILE_URL=https://tiles.sehitkamil.gov.tr/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; Şehitkamil Belediyesi Harita Servisi

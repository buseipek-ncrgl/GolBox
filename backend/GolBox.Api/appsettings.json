{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=golbox.db"
  },
  "Jwt": {
    "Issuer": "GolBox.Api",
    "Audience": "GolBox.Frontend",
    "ExpiresMinutes": 480
  },
  "Storage": {
    "UploadsPath": "",
    "PublicBaseUrl": ""
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": []
    },
    "DynamicQr": {
      "AllowLegacyGuid": false
    }
  }
}

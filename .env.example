# Şehitkamil+ environment template
# Copy to a secret store or host env. Never commit real secrets.

# --- API (ASP.NET) ---
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=Server=CHANGE_ME;Database=SehitkamilPlus;User Id=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True
Jwt__Key=CHANGE_ME_MIN_32_CHARS
Jwt__Issuer=GolBox.Api
Jwt__Audience=GolBox.Frontend
Jwt__ExpiresMinutes=480
Security__DynamicQr__HmacKey=CHANGE_ME_MIN_32_CHARS
Security__DynamicQr__AllowLegacyGuid=false
Security__Cors__AllowedOrigins__0=https://citizen.example.gov.tr
Security__Cors__AllowedOrigins__1=https://admin.example.gov.tr
BootstrapAdmin__Email=CHANGE_ME
BootstrapAdmin__Password=CHANGE_ME_MIN_12_CHARS
Storage__UploadsPath=/var/lib/sehitkamil/uploads
Storage__PublicBaseUrl=https://api.example.gov.tr

# --- Citizen (Next.js) — BUILD-TIME. Rebuild after changing these. ---
# Value must include the API prefix (same shape as local http://localhost:5155/api/v1).
NEXT_PUBLIC_API_BASE_URL=https://api.example.gov.tr/api/v1
NEXT_PUBLIC_HUB_URL=https://api.example.gov.tr/hubs/orders
NEXT_PUBLIC_NOTIFICATION_HUB_URL=https://api.example.gov.tr/hubs/notifications
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.gov.tr/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© Tile provider

# Same-origin reverse proxy alternative: omit NEXT_PUBLIC_API_BASE_URL / HUB_URL
# so production falls back to /api/v1 and /hubs/orders. Map tile env is still required.

# --- Admin (Vite) — BUILD-TIME. Rebuild after changing these. ---
VITE_API_BASE_URL=https://api.example.gov.tr/api/v1
VITE_MAP_TILE_URL=https://tiles.example.gov.tr/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© Tile provider

# --- Deprecated (NOT read by application code) ---
# NEXT_PUBLIC_API_URL  → use NEXT_PUBLIC_API_BASE_URL
# VITE_API_URL         → use VITE_API_BASE_URL
